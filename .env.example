# ReTryp API — environment
#
# Every value here is optional. With an empty environment the application runs
# end to end on the bundled reference and timetable datasets and any configured
# provider, and reports a source that could not answer as unavailable rather
# than inventing a value. Copy to `.env` (repo root or backend/) and fill in
# only what you need.

# --- app ---------------------------------------------------------------
ENVIRONMENT=development
# SQLite by default. Set a PostgreSQL DSN for shared deployments.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/retryp
DATABASE_URL=
# Comma-separated list. Point this at the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_HOURS=336
# Set true when the API is served over HTTPS.
COOKIE_SECURE=false
PROVIDER_CACHE_TTL_SECONDS=900

# --- accounts ----------------------------------------------------------
# ReTryp seeds no trips. It creates three sign-in accounts only. Set
# BOOTSTRAP_PASSWORD (or let the bootstrap command generate one and print it).
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=ops@retryp.example
BOOTSTRAP_MANAGER_EMAIL=manager@retryp.example
BOOTSTRAP_TRAVELLER_EMAIL=traveller@retryp.example

# --- flights -----------------------------------------------------------
# aerodatabox | aviationstack | flightaware. Empty auto-detects from whichever
# key is set. There is no demo provider.
FLIGHT_PROVIDER=
AERODATABOX_API_KEY=
AVIATIONSTACK_API_KEY=
FLIGHTAWARE_API_KEY=

# --- aircraft positions (OpenSky) -------------------------------------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- ground transport --------------------------------------------------
TRANSITLAND_API_KEY=
MOBILITY_DATABASE_API_KEY=
# Optional explicit GTFS-Realtime endpoints, comma-separated.
GTFS_RT_URLS=

# --- hotels ------------------------------------------------------------
# Leave these empty unless you hold a contracted Amadeus Enterprise key. The
# reference lookup returns hotel records, not rates, so availability is never
# claimed from it.
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- maps and routing --------------------------------------------------
NOMINATIM_USER_AGENT=ReTryp/1.0 (contact: ops@retryp.example)
OSRM_BASE_URL=https://router.project-osrm.org

# --- currency and FX ---------------------------------------------------
# Amounts are stored in the currency they were quoted in. The viewer's
# preferred currency (Profile / Settings) is applied on read. Rates come from
# the free Frankfurter API (European Central Bank reference rates); set
# FX_ENABLED=false to stay offline.
FX_ENABLED=true
FX_BASE_URL=https://api.frankfurter.app
# The currency a viewer sees when they have not chosen one in Profile or
# Settings. Default INR.
FX_DISPLAY_CURRENCY=INR
FX_CACHE_TTL_SECONDS=3600
FX_TIMEOUT_SECONDS=10

# --- LLM (optional) ----------------------------------------------------
# Empty provider disables the LLM; deterministic templates are used instead.
# gemini | openai_compatible | ""
LLM_PROVIDER=
# One place to change the model id.
LLM_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=
# For openai_compatible: Groq, OpenRouter or a local Ollama server.
#   Groq         https://api.groq.com/openai/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

# Optional second provider used when the first errors or is rate limited.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
